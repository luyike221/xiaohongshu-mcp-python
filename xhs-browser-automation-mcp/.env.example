# 小红书 MCP 环境变量示例
# 使用方式：复制为 .env 后按需修改
#   cp .env.example .env
# 应用会在导入 xiaohongshu_mcp_python.config.settings 时从项目根目录加载 .env

# ============ 运行环境 ============
# development | production（影响默认是否无头、默认日志级别等）
ENV=development

# ============ 浏览器 ============
# true / false；留空则：production 默认无头，development 默认有头
# BROWSER_HEADLESS=false

# 使用本机 Chrome/Chromium 时填写可执行文件路径；留空则使用 Playwright 内置 Chromium
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# ============ 日志 ============
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=DEBUG

# 日志文件路径（留空则只输出到控制台）；相对路径相对于项目根目录
# LOG_FILE=logs/xiaohongshu-mcp.log

# 自定义 loguru 格式（含 {time}、{level} 等占位符时需用引号包裹）
# LOG_FORMAT="{time:YYYY-MM-DD HH:mm:ss} | {level:<8} | {name}:{function}:{line} - {message}"

# ============ HTTP 服务（与 CLI --host/--port 一致时可被命令行覆盖）============
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ============ 用户 ============
GLOBAL_USER=luyike

# ============ 超时（毫秒，除非另有说明）============
# 元素等待、点击等（PageController 默认）
ELEMENT_TIMEOUT=30000

# page.goto / 页面导航
PAGE_LOAD_TIMEOUT=60000

# 其它逻辑使用的通用默认（毫秒）；不设置时与 ELEMENT_TIMEOUT 相同
# DEFAULT_TIMEOUT=30000

# 上传等大操作（毫秒）
UPLOAD_TIMEOUT=120000

# ============ 登录流程 ============
# 阻塞等待扫码登录完成的总时间（秒）
LOGIN_WAIT_TIMEOUT=90

# 等待登录二维码 DOM 出现（毫秒）
LOGIN_QR_WAIT_MS=90000

# ============ 调试 / 测试 ============
# 开发环境下是否保存调试截图：true | false
# DEBUG_SCREENSHOTS=false

# 发布流程测试：为 true 时阻塞且不点最终发布（详见代码说明）
# PUBLISH_BLOCK_TEST=false

# ============ 存储路径（可选）============
# 默认 Cookie 文件路径（未在代码里传 cookie_path 时生效）；相对路径相对于项目根目录
# COOKIES_PATH=cookies.json

# 用户会话映射文件路径（默认：项目根目录 user_sessions.json）
# USER_SESSION_STORAGE_PATH=user_sessions.json
